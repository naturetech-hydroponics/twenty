# Twenty CRM Local Environment Configuration
# Generated for local Docker deployment

# ============================================
# VERSION
# ============================================
TWENTY_VERSION=latest

# ============================================
# DOMAIN & URLs
# ============================================
# For local deployment, use localhost
DOMAIN=localhost
SERVICE_FQDN_SERVER=http://localhost:3000

# ============================================
# DATABASE
# ============================================
# PostgreSQL password - CHANGE THIS for production!
SERVICE_PASSWORD_POSTGRES=TwentyLocalDB2026SecurePass

# ============================================
# SECURITY
# ============================================
# Application secret - 32-character base64 secret
SERVICE_BASE64_32_SECRET=3b6M7mqkV21Qix0H6IrazzSCZVY83bWv+LqNKmqvvno=

# ============================================
# STORAGE (Optional)
# ============================================
# Use local storage by default
STORAGE_TYPE=local

# ============================================
# GOOGLE OAUTH (Optional)
# ============================================
MESSAGING_PROVIDER_GMAIL_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false

# ============================================
# MICROSOFT OAUTH (Optional)
# ============================================
CALENDAR_PROVIDER_MICROSOFT_ENABLED=false
MESSAGING_PROVIDER_MICROSOFT_ENABLED=false
AUTH_MICROSOFT_ENABLED=false

# ============================================
# EMAIL (Optional)
# ============================================
EMAIL_DRIVER=smtp
